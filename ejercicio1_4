        "import ipywidgets as widgets\n",
        "from IPython.display import display\n",
        "\n",
        "class PruebaExcepciones:\n",
        "\n",
        "    def ejecutar(self) -> list:\n",
        "        resultados = []\n",
        "\n",
        "        try:\n",
        "            resultados.append((\"Ingresando al primer try\", \"try\"))\n",
        "            cociente = 10000 / 0                        # Lanza ZeroDivisionError\n",
        "            resultados.append((\"Después de la división\", \"try\"))\n",
        "        except ZeroDivisionError:\n",
        "            resultados.append((\"División por cero\", \"except\"))\n",
        "        finally:\n",
        "            resultados.append((\"Ingresando al primer finally\", \"finally\"))\n",
        "\n",
        "        # ── Segundo bloque try ────────────────────────────────────────────\n",
        "        try:\n",
        "            resultados.append((\"Ingresando al segundo try\", \"try\"))\n",
        "            objeto = None\n",
        "            objeto.upper()                              # Lanza AttributeError\n",
        "            resultados.append((\"Imprimiendo objeto\", \"try\"))\n",
        "        except ZeroDivisionError:\n",
        "            resultados.append((\"División por cero\", \"except\"))\n",
        "        except Exception:\n",
        "            resultados.append((\"Ocurrió una excepción\", \"except\"))\n",
        "        finally:\n",
        "            resultados.append((\"Ingresando al segundo finally\", \"finally\"))\n",
        "\n",
        "        return resultados\n",
        "\n",
        "\n",
        "# ─────────────────────────────────────────────────────────────────────────────\n",
        "# Interfaz gráfica con ipywidgets (solo widgets, sin HTML de IPython)\n",
        "# ─────────────────────────────────────────────────────────────────────────────\n",
        "\n",
        "class Aplicacion:\n",
        "\n",
        "    COLORES = {\n",
        "        \"try\":     \"#38bdf8\",\n",
        "        \"except\":  \"#f87171\",\n",
        "        \"finally\": \"#4ade80\",\n",
        "    }\n",
        "\n",
        "    def __init__(self):\n",
        "        self.prueba = PruebaExcepciones()\n",
        "        self._construir_ui()\n",
        "\n",
        "    def _construir_ui(self):\n",
        "\n",
        "        titulo = widgets.HTML(\"\"\"\n",
        "        <div style=\"background:#2a2a3e;padding:16px 24px;border-radius:10px 10px 0 0;\n",
        "                    border-bottom:2px solid #7c3aed;\">\n",
        "          <span style=\"color:#a78bfa;font-size:17px;font-weight:bold;font-family:sans-serif;\">\n",
        "            Ejercicio 6.4 – Excepciones\n",
        "          </span><br>\n",
        "          <span style=\"color:#94a3b8;font-size:12px;font-family:sans-serif;\">\n",
        "            Demuestra el comportamiento de bloques try / except / finally\n",
        "          </span>\n",
        "        </div>\n",
        "        \"\"\")\n",
        "\n",
        "        leyenda = widgets.HTML(\"\"\"\n",
        "        <div style=\"background:#1e1e2e;padding:10px 24px;font-family:sans-serif;font-size:13px;\">\n",
        "          <span style=\"color:#38bdf8;margin-right:20px;\">● Bloque try</span>\n",
        "          <span style=\"color:#f87171;margin-right:20px;\">● Excepción capturada</span>\n",
        "          <span style=\"color:#4ade80;\">● Bloque finally</span>\n",
        "        </div>\n",
        "        \"\"\")\n",
        "\n",
        "        self.area_salida = widgets.HTML(\n",
        "            value='<div style=\"background:#0f0f1a;min-height:200px;padding:16px 24px;'\n",
        "                  'color:#64748b;font-family:Courier New,monospace;font-size:13px;\">'\n",
        "                  'Presiona ▶ Ejecutar para ver el resultado...</div>'\n",
        "        )\n",
        "\n",
        "        btn_ejecutar = widgets.Button(\n",
        "            description=\"▶  Ejecutar programa\",\n",
        "            layout=widgets.Layout(width='180px', height='36px')\n",
        "        )\n",
        "        btn_ejecutar.style.button_color = '#7c3aed'\n",
        "        btn_ejecutar.style.font_weight = 'bold'\n",
        "\n",
        "        btn_limpiar = widgets.Button(\n",
        "            description=\"⟳  Limpiar\",\n",
        "            layout=widgets.Layout(width='120px', height='36px')\n",
        "        )\n",
        "        btn_limpiar.style.button_color = '#374151'\n",
        "\n",
        "        btn_ejecutar.on_click(self._ejecutar)\n",
        "        btn_limpiar.on_click(self._limpiar)\n",
        "\n",
        "        caja_botones = widgets.HBox(\n",
        "            [btn_ejecutar, btn_limpiar],\n",
        "            layout=widgets.Layout(padding='12px 24px', gap='12px',\n",
        "                                  background_color='#1e1e2e')\n",
        "        )\n",
        "\n",
        "        pie = widgets.HTML(\"\"\"\n",
        "        <div style=\"background:#2a2a3e;padding:8px 24px;border-radius:0 0 10px 10px;\n",
        "                    font-family:sans-serif;font-size:11px;color:#64748b;\">\n",
        "          Ejercicios de POO con Java y UML · Leonardo Bermón Angarita · UNAL\n",
        "        </div>\n",
        "        \"\"\")\n",
        "\n",
        "        self.app = widgets.VBox(\n",
        "            [titulo, leyenda, self.area_salida, caja_botones, pie],\n",
        "            layout=widgets.Layout(\n",
        "                border='1px solid #374151',\n",
        "                width='620px',\n",
        "                background_color='#1e1e2e'\n",
        "            )\n",
        "        )\n",
        "\n",
        "    def _ejecutar(self, _=None):\n",
        "        resultados = self.prueba.ejecutar()\n",
        "\n",
        "        lineas = \"\"\n",
        "        for msg, tipo in resultados:\n",
        "            color = self.COLORES.get(tipo, \"#e2e8f0\")\n",
        "            lineas += (\n",
        "                f'<div style=\"color:{color};font-family:Courier New,monospace;'\n",
        "                f'font-size:14px;padding:3px 0;\">  {msg}</div>'\n",
        "            )\n",
        "\n",
        "        self.area_salida.value = f\"\"\"\n",
        "        <div style=\"background:#0f0f1a;padding:16px 24px;\">\n",
        "          <div style=\"color:#64748b;font-family:Courier New,monospace;font-size:12px;margin-bottom:10px;\">\n",
        "            ── Ejecución del programa ──\n",
        "          </div>\n",
        "          {lineas}\n",
        "          <div style=\"color:#64748b;font-family:Courier New,monospace;font-size:12px;margin-top:10px;\">\n",
        "            ── Fin de la ejecución ──\n",
        "          </div>\n",
        "        </div>\n",
        "        \"\"\"\n",
        "\n",
        "    def _limpiar(self, _=None):\n",
        "        self.area_salida.value = (\n",
        "            '<div style=\"background:#0f0f1a;min-height:200px;padding:16px 24px;'\n",
        "            'color:#64748b;font-family:Courier New,monospace;font-size:13px;\">'\n",
        "            'Presiona ▶ Ejecutar para ver el resultado...</div>'\n",
        "        )\n",
        "\n",
        "    def mostrar(self):\n",
        "        display(self.app)\n",
        "\n",
        "\n",
        "# ─────────────────────────────────────────────────────────────────────────────\n",
        "def main():\n",
        "    app = Aplicacion()\n",
        "    app.mostrar()\n",
        "\n",
        "main()"
      ],
